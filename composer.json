{
  "name": "sendery/php",
  "description": "Sendery php template email SDK",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Sendery\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests"
  },
  "support": {
    "source": "https://github.com/sendery-co/sendery-php",
    "issues": "https://github.com/sendery-co/sendery-php/issues"
  }
}
